# ==========================================================
# littledotmcp 配置模板（复制为 .env 后填写；密钥一律不入库）
# 全部配置经 pydantic-settings 读取：默认值 < .env < 环境变量
# ==========================================================

# ---- 运行模式 ----
# stdio：本地被 MCP 客户端拉起（默认）；http：服务端远程（streamable-http）
MCP_TRANSPORT=stdio

# ---- 鉴权（http 模式必填）----
MCP_AUTH_TOKEN=

# ---- LLM / Embedding（M3 知识库起需要；OpenAI 兼容或本地 Ollama）----
# 示例为阿里云百炼 OpenAI 兼容端点；自建网关/DeepSeek/智谱同理改 base_url
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 本地离线：改 http://localhost:11434/v1 且模型名填 Ollama 模型
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
# provider：openai（OpenAI 兼容端点）/ ollama（本地 Ollama）/ fake（离线确定性向量，默认）
EMBEDDING_PROVIDER=fake
# 维度须与所选模型一致：百炼 text-embedding-v3=1024、Ollama 常见 768、fake=32
EMBEDDING_DIM=32

# ---- 存储（默认全走本地目录，零外部中间件）----
DB_URL=sqlite:///./data/littledotmcp.db
STORAGE_ROOT=./data/files
VECTOR_DIR=./data/vectors

# ---- 企业微信（M3 可选：微盘/文档 API；未配置则仅用本地存储）----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# ---- 服务端（M6）----
HTTP_HOST=0.0.0.0
HTTP_PORT=8890

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs
